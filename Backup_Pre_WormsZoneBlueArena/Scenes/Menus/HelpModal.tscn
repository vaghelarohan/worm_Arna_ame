[gd_scene format=3]

[ext_resource type="StyleBox" path="res://Resources/tile_style.tres" id="1_tile"]
[ext_resource type="StyleBox" path="res://Resources/btn_gold.tres" id="2_btngd"]
[ext_resource type="FontFile" path="res://Assets/Fonts/LilitaOne-Regular.ttf" id="3_lilita"]
[ext_resource type="FontFile" path="res://Assets/Fonts/Fredoka.ttf" id="4_fredoka"]

[node name="HelpModal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Grid" type="GridContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/h_separation = 20
theme_override_constants/v_separation = 20
columns = 2

[node name="Step1" type="Panel" parent="Grid"]
custom_minimum_size = Vector2(400, 110)
layout_mode = 2
theme_override_styles/panel = ExtResource("1_tile")

[node name="HBox" type="HBoxContainer" parent="Grid/Step1"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16

[node name="Badge" type="Panel" parent="Grid/Step1/HBox"]
