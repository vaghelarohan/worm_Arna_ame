[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/UI/InfinityModal.gd" id="1_infsc"]
[ext_resource type="Texture2D" path="res://Assets/Icons/infinity.svg" id="2_inficon"]
[ext_resource type="FontFile" path="res://Assets/Fonts/Fredoka.ttf" id="3_fredoka"]
[ext_resource type="FontFile" path="res://Assets/Fonts/LilitaOne-Regular.ttf" id="4_lilita"]
[ext_resource type="StyleBox" path="res://Resources/btn_green.tres" id="5_btngr"]
[ext_resource type="Script" path="res://Scripts/UI/GameButton.gd" id="6_gmbtn"]

[node name="InfinityModal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_infsc")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 24
alignment = 1

[node name="Icon" type="TextureRect" parent="VBox"]
custom_minimum_size = Vector2(112, 112)
layout_mode = 2
size_flags_horizontal = 4
texture = ExtResource("2_inficon")
expand_mode = 1
stretch_mode = 5

[node name="Desc" type="Label" parent="VBox"]
layout_mode = 2
theme_override_fonts/font = ExtResource("3_fredoka")
theme_override_font_sizes/font_size = 22
text = "No timer. No mercy. Grow forever and climb the endless leaderboard."
horizontal_alignment = 1

[node name="BestScore" type="Label" parent="VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.984314, 0.74902, 0.141176, 1)
theme_override_colors/font_outline_color = Color(0.0431373, 0.0470588, 0.117647, 1)
theme_override_constants/outline_size = 6
theme_override_fonts/font = ExtResource("4_lilita")
theme_override_font_sizes/font_size = 28
text = "Your best: 1,250"
horizontal_alignment = 1

[node name="EnterBtn" type="Button" parent="VBox"]
custom_minimum_size = Vector2(280, 70)
layout_mode = 2
size_flags_horizontal = 4
theme_override_colors/font_outline_color = Color(0.0431373, 0.0470588, 0.117647, 1)
theme_override_constants/outline_size = 6
theme_override_fonts/font = ExtResource("4_lilita")
theme_override_font_sizes/font_size = 32
theme_override_styles/normal = ExtResource("5_btngr")
theme_override_styles/hover = ExtResource("5_btngr")
theme_override_styles/pressed = ExtResource("5_btngr")
text = "ENTER ARENA"
script = ExtResource("6_gmbtn")
